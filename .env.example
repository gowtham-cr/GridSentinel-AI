# GridSentinel AI - Environment Configuration

# Application Configuration
APP_NAME=GridSentinel AI
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# Security & CORS
CORS_ORIGINS=["*"]
SECRET_KEY=gridsentinel_development_secret_key_change_in_production_32bytes

# Database Configuration
# Uses SQLite for local zero-dependency microgrid security logging
DATABASE_URL=sqlite:///./gridsentinel.db

# Electrical Grid Simulation
DEFAULT_GRID_TOPOLOGY=cigre_microgrid
POWER_FLOW_ALGORITHM=nr
VOLTAGE_LOWER_LIMIT_PU=0.95
VOLTAGE_UPPER_LIMIT_PU=1.05
MAX_LINE_LOADING_PERCENT=100.0

# Telemetry Configuration
TELEMETRY_SAMPLE_RATE_HZ=2.0
TELEMETRY_NOISE_STD_DEV=0.002
TELEMETRY_BUFFER_SIZE=500

# Cybersecurity AI Detection
ML_MODEL_TYPE=isolation_forest
ANOMALY_CONTAMINATION_RATE=0.05
RESIDUAL_THRESHOLD_MW=0.15
AUTO_RETRAIN_INTERVAL_MINUTES=60
MODEL_STORAGE_DIR=./models_data

